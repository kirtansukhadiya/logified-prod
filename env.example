# Copy to .env and fill in values

PORT=3000
SELF_URL=https://logified.in/health

# Gmail — use your Gmail address and a 16-character App Password (not your normal password)
# Create at: Google Account → Security → 2-Step Verification → App passwords
EMAIL_USER=info.logified@gmail.com
EMAIL_PASS=your-16-char-gmail-app-password

# Optional: where inquiries are delivered (defaults to EMAIL_USER)
# CONTACT_TO=info.logified@gmail.com

# Optional: if port 465 fails on your host, try STARTTLS on 587
# SMTP_PORT=587
# SMTP_SECURE=false
