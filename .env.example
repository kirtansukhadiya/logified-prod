# Server
PORT=3000
SELF_URL=https://logified.in/health

# Contact form email (use ONE of the options below)

# Option A — Resend (recommended for Render/production; uses HTTPS, not SMTP)
# Sign up at https://resend.com, create an API key, verify your domain
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=LOGIFIED SOLUTIONS <noreply@logified.in>
CONTACT_TO=info.logified@gmail.com

# Option B — Gmail SMTP (local dev; may time out on some cloud hosts)
EMAIL_USER=info.logified@gmail.com
EMAIL_PASS=your-16-char-gmail-app-password
